<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Manifest injection (UPL) for PICO Icon Configurator plugin.
    When packaging for Android, the engine automatically merges the following changes into the generated AndroidManifest.xml:
      - <application> android:icon        → @mipmap/ic_spatial_launcher
      - <application> android:label       → @string/app_name
      - <application> android:localeConfig → @xml/locales_config
      - Injects two meta-data entries: icon.3d.list / icon.sdf.list
    Resource files are generated by the plugin's Apply action into <Project>/Build/Android/res/.
-->
<root xmlns:android="http://schemas.android.com/apk/res/android">

    <androidManifestUpdates>

        <!-- Modify existing <application> attributes: remove then re-add to ensure engine defaults are overridden -->
        <loopElements tag="application">
            <removeAttribute tag="$" name="android:icon"/>
            <addAttribute tag="$" name="android:icon" value="@mipmap/ic_spatial_launcher"/>

            <removeAttribute tag="$" name="android:label"/>
            <addAttribute tag="$" name="android:label" value="@string/app_name"/>

            <removeAttribute tag="$" name="android:localeConfig"/>
            <addAttribute tag="$" name="android:localeConfig" value="@xml/locales_config"/>
        </loopElements>

        <!-- Inject layered icon meta-data into <application> (fixed resource names) -->
        <addElements tag="application">
            <meta-data android:name="icon.3d.list"  android:resource="@array/icon_3d_list"/>
            <meta-data android:name="icon.sdf.list" android:resource="@array/icon_sdf_list"/>
        </addElements>

    </androidManifestUpdates>

</root>
