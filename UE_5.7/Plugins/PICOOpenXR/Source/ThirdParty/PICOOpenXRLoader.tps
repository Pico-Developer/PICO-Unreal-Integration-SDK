<?xml version="1.0" encoding="utf-8"?>
<TpsData xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>PICO OpenXR Loader</Name>
  <Location>/Plugins/PICOOpenXR/Source/ThirdParty/PICOOpenXRLoader</Location>
  <Function>PICO OpenXR Loader provides OpenXR headers and Android loader binaries for the PICO OpenXR plugin. It includes files derived from the Khronos OpenXR SDK together with PICO-authored extensions and modifications.</Function>
  <Eula>https://github.com/KhronosGroup/OpenXR-SDK-Source/blob/main/LICENSE</Eula>
  <RedistributeTo>
    <EndUserGroup>Licensees</EndUserGroup>
    <EndUserGroup>Git</EndUserGroup>
    <EndUserGroup>P4</EndUserGroup>
  </RedistributeTo>
  <LicenseFolder>/Plugins/PICOOpenXR/Source/ThirdParty/Licenses</LicenseFolder>
</TpsData>
